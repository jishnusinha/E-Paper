# Root / shared development defaults
# Copy to apps/api/.env and apps/web/.env as needed

# === Backend (apps/api/.env) ===
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/epaper_studio
CLIENT_URL=http://localhost:5173
# Optional. Public URL of the API itself (used for /media links).
# On Railway this can usually be omitted; RAILWAY_PUBLIC_DOMAIN is used.
# PUBLIC_API_URL=https://epaperapi-production.up.railway.app
JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=epaper_token

# Used for rendered page images/crops. Original newspaper PDFs stay on API disk
# because Cloudinary free plans reject raw files over 10MB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeStrong123!

MAX_PDF_UPLOAD_MB=100
PDF_RENDER_TARGET_WIDTH=3000
PDF_PROCESSING_CONCURRENCY=2

# === Sarvam Document AI (optional) ===
# Get a key at https://dashboard.sarvam.ai — never expose this to the frontend.
SARVAM_API_KEY=
# Master switch. When false or key missing, manual segmentation still works.
SARVAM_AI_ENABLED=false
SARVAM_MAX_PAGES_PER_DAY=3
SARVAM_MAX_REQUESTS_PER_DAY=5
SARVAM_MONTHLY_BUDGET_INR=50
SARVAM_POLL_INTERVAL_SECONDS=5
SARVAM_ESTIMATED_COST_PER_PAGE_INR=0.5
SARVAM_BASE_URL=https://api.sarvam.ai

# === Frontend (apps/web/.env) ===
# Prefer /api in local development (Vite proxies to the API and avoids CORS).
# Use a full URL only when the web app is not proxied to the API.
VITE_API_BASE_URL=/api
